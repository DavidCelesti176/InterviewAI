# Server-only. Set these in the Netlify UI under Site configuration → Environment variables.
# Do not prefix them with NEXT_PUBLIC. The browser must never receive the API key.
OPENAI_API_KEY=
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_LIVE_VOICE=meridian
OPENAI_PLAN_MODEL=gpt-5.4
OPENAI_ANALYSIS_MODEL=gpt-5.4
OPENAI_COACHING_MODEL=gpt-5.4
COMPANY_PROFILE_TTL_DAYS=45
