# Server-only. Set these in the Netlify UI under Site configuration → Environment variables.
# Do not prefix them with NEXT_PUBLIC. The browser must never receive the API key.
OPENAI_API_KEY=
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_LIVE_VOICE=meridian
# Role analysis, the interview blueprint, and company research.
OPENAI_PLAN_MODEL=gpt-5.4
# Written review. Help, Story Builder, and pasted job listings use this unless overridden.
OPENAI_ANALYSIS_MODEL=gpt-5.4-mini
OPENAI_COACHING_MODEL=gpt-5.4-mini
OPENAI_STORY_MODEL=gpt-5.4-mini
COMPANY_PROFILE_TTL_DAYS=45
# Development only. Production ignores this and keeps billing fail-closed.
# Set to 1 locally if you want the old ungated interview path.
DEV_BILLING_BYPASS=

# Server-only Stripe sandbox keys. Never prefix these with NEXT_PUBLIC.
# Use the InterviewAI sandbox (test mode). Do not set sk_live keys.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FULL_MOCK=
STRIPE_PRICE_PLUS=
# Stripe Tax is not enabled in application code. Monitor thresholds in the
# Stripe Dashboard → Tax settings for the InterviewAI sandbox, then revisit
# registration/collection after real sales. Smart Retries stay in Billing settings.

# Public Firebase web config. Safe to expose to the browser. No secrets.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Server-only Firebase Admin. Never prefix these with NEXT_PUBLIC.
# On Netlify, store the private key with escaped newlines (\n). The server converts them.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
